# Shared password for the owner and the secretary. If empty, the demo password is "demo".
APP_ACCESS_PASSWORD=

# Vision for a photographed stop sheet. Gemini is preferred and has a free AI Studio tier.
# Leave every vision key empty to use the built-in Hebrew text parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# gemini | anthropic | openai | none
VISION_PROVIDER=

# Road times and the route line. Without it, distances are labelled as estimates.
ORS_API_KEY=

# Optional. Without it, addresses are geocoded with Nominatim.
GOOGLE_MAPS_API_KEY=
